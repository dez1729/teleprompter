{
  "plugins": [
    "./node_modules/prettier-plugin-tailwindcss/dist/index.mjs",
    "./node_modules/prettier-plugin-brace-style/dist/index.js",
    "./node_modules/prettier-plugin-merge/dist/index.js"
  ],
  "tailwindFunctions": ["cn"],
  "tailwindStylesheet": "./apps/web/src/index.css",
  "singleAttributePerLine": true,
  "printWidth": 150,
  "tabWidth": 2,
  "useTabs": false,
  "semi": true,
  "singleQuote": false,
  "trailingComma": "es5",
  "bracketSpacing": true,
  "bracketSameLine": false,
  "arrowParens": "always",
  "requirePragma": false,
  "insertPragma": false,
  "braceStyle": "stroustrup"
}
