{
  "name": "teleprompter",
  "private": true,
  "license": "MIT",
  "packageManager": "pnpm@12.18.0",
  "scripts": {
    "dev": "pnpm --parallel --filter web --filter @teleprompter/server dev",
    "start": "node packages/cli/bin/tp.js serve",
    "build": "pnpm --filter web build",
    "link:tp": "pnpm add --global link:./packages/cli",
    "install:obsidian": "pnpm --filter @teleprompter/obsidian install-plugin",
    "test:e2e": "pnpm build && pnpm --filter @teleprompter/e2e test:e2e",
    "lint": "oxlint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "bench:follow": "pnpm build && pnpm --filter @teleprompter/e2e bench:follow",
    "bench:rate": "pnpm build && pnpm --filter @teleprompter/e2e bench:rate"
  },
  "engines": {
    "node": ">=22.18"
  },
  "devDependencies": {
    "eslint-plugin-react-you-might-not-need-an-effect": "1.2.0",
    "oxlint": "1.93.0",
    "oxlint-plugin-eslint": "1.93.0",
    "oxlint-tsgolint": "7.0.2007",
    "prettier": "3.10.1",
    "prettier-plugin-brace-style": "0.10.4",
    "prettier-plugin-merge": "0.10.2",
    "prettier-plugin-tailwindcss": "0.8.1"
  }
}
